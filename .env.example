# Public build-time origin for Capacitor / Electron shells.
# Leave empty for same-origin web (local Next rewrite or Hostinger static+API).
# Example: https://your-domain.hostingersite.com
NEXT_PUBLIC_API_BASE=

# Server-only (never put these in the client shell)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# PORT=3000
