[
 {
  "a": 0.15,
  "b": 2.598,
  "text": "وكيل الذكاء الاصطناعي في شركتك…"
 },
 {
  "a": 2.598,
  "b": 4.562,
  "text": "ينجز مهمة عادية."
 },
 {
  "a": 4.4,
  "b": 7.668,
  "text": "لكن في الإيميل سطر واحد مدسوس…"
 },
 {
  "a": 7.668,
  "b": 11.01,
  "text": "يأمره بتسريب بيانات عملائك."
 },
 {
  "a": 10.936,
  "b": 14.72,
  "text": "الهارنس يبحث عن اسم الأداة في قائمته…"
 },
 {
  "a": 14.72,
  "b": 15.538,
  "text": "ما يجده،"
 },
 {
  "a": 15.538,
  "b": 16.551,
  "text": "فيسمح."
 },
 {
  "a": 16.45,
  "b": 18.727,
  "text": "وهكذا تتسرب البيانات اليوم…"
 },
 {
  "a": 18.727,
  "b": 20.731,
  "text": "بصياغة جديدة،"
 },
 {
  "a": 20.731,
  "b": 22.528,
  "text": "لم يرها أحد."
 },
 {
  "a": 24.45,
  "b": 26.592,
  "text": "إلا إذا كان هناك من يتذكر."
 },
 {
  "a": 26.592,
  "b": 29.151,
  "text": "CAUSASEAL… يحفظ سبب الحادثة،"
 },
 {
  "a": 29.151,
  "b": 30.456,
  "text": "لا كلماتها."
 },
 {
  "a": 32.47,
  "b": 33.977,
  "text": "يعيد بناء ما حدث:"
 },
 {
  "a": 33.977,
  "b": 35.484,
  "text": "من أين جاء الأمر،"
 },
 {
  "a": 35.484,
  "b": 36.991,
  "text": "وأي بيانات ستخرج،"
 },
 {
  "a": 36.991,
  "b": 38.189,
  "text": "وإلى أين."
 },
 {
  "a": 40.482,
  "b": 43.642,
  "text": "ويقارن شكل المسار ببصمة حادثة سابقة."
 },
 {
  "a": 43.642,
  "b": 44.943,
  "text": "الكلمات تغيرت…"
 },
 {
  "a": 44.943,
  "b": 46.25,
  "text": "والشكل نفسه."
 },
 {
  "a": 46.25,
  "b": 47.355,
  "text": "فيتدخل."
 },
 {
  "a": 50.975,
  "b": 52.85,
  "text": "لا يوقف العمل كله."
 },
 {
  "a": 52.85,
  "b": 54.783,
  "text": "يقطع خيطا واحدا…"
 },
 {
  "a": 54.783,
  "b": 55.975,
  "text": "فيحجب الأصل،"
 },
 {
  "a": 55.975,
  "b": 57.875,
  "text": "وتصل نسخة آمنة،"
 },
 {
  "a": 57.875,
  "b": 59.566,
  "text": "وتكتمل المهمة."
 },
 {
  "a": 60.15,
  "b": 61.342,
  "text": "غير الصياغة،"
 },
 {
  "a": 61.342,
  "b": 62.434,
  "text": "غير الأداة،"
 },
 {
  "a": 62.434,
  "b": 63.825,
  "text": "حتى غير اللغة…"
 },
 {
  "a": 63.825,
  "b": 65.116,
  "text": "البصمة نفسها،"
 },
 {
  "a": 65.116,
  "b": 66.807,
  "text": "والقرار نفسه."
 },
 {
  "a": 69.682,
  "b": 71.391,
  "text": "وهذه ليست وعودا."
 },
 {
  "a": 71.391,
  "b": 73.947,
  "text": "أربع حالات حقيقية على المحرك:"
 },
 {
  "a": 73.947,
  "b": 75.573,
  "text": "حيث سمح الهارنس،"
 },
 {
  "a": 75.573,
  "b": 76.564,
  "text": "قطعت البصمة…"
 },
 {
  "a": 76.564,
  "b": 78.325,
  "text": "وحيث كان العمل سليما،"
 },
 {
  "a": 78.325,
  "b": 79.636,
  "text": "تركته يمضي."
 },
 {
  "a": 81.85,
  "b": 85.164,
  "text": "ويركب فوق وكيلك بثلاث طرق:"
 },
 {
  "a": 85.164,
  "b": 87.077,
  "text": "HTTP وMCP وSDK…"
 },
 {
  "a": 87.077,
  "b": 89.261,
  "text": "وكل قرار موثق."
 },
 {
  "a": 89.15,
  "b": 90.248,
  "text": "CAUSASEAL."
 },
 {
  "a": 90.248,
  "b": 91.72,
  "text": "الصياغة تتغير…"
 },
 {
  "a": 91.72,
  "b": 93.235,
  "text": "والسبب يبقى."
 }
]