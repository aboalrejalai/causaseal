{
  "appId": "sa.causaseal.app",
  "productName": "CAUSASEAL",
  "directories": {
    "buildResources": "resources",
    "output": "dist"
  },
  "files": [
    "assets/**/*",
    "build/**/*",
    "capacitor.config.*",
    "app/**/*"
  ],
  "publish": {
    "provider": "github"
  },
  "nsis": {
    "allowElevation": true,
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "win": {
    "target": "nsis",
    "icon": "assets/appIcon.ico"
  },
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": [
      "dmg",
      "zip"
    ],
    "icon": "assets/appIcon.png"
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Security",
    "icon": "assets/appIcon.png",
    "synopsis": "Causal AI Governance Gateway & SERMG Platform",
    "description": "Enterprise causal-invariants gateway for autonomous AI agents."
  }
}