{
  "name": "site-creator-vinext-starter",
  "version": "0.10.1",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "node scripts/dev.mjs",
    "dev:vinext": "node scripts/run-framework.mjs dev",
    "build": "next build --webpack && node scripts/hostinger-build.mjs",
    "start": "node server.js",
    "test": "node --test test/**/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern out --ignore-pattern android --ignore-pattern ios --ignore-pattern electron",
    "db:generate": "drizzle-kit generate",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:open:electron": "npx cap open @capacitor-community/electron",
    "build:android": "npx cap build android",
    "build:ios": "npx cap build ios",
    "build:mac": "npm --prefix electron run build:mac",
    "build:linux": "npm --prefix electron run build:linux",
    "build:win": "npm --prefix electron run build:win",
    "pack:mac": "npm --prefix electron run pack:mac",
    "pack:linux": "npm --prefix electron run pack:linux",
    "pack:win": "npm --prefix electron run pack:win"
  },
  "main": "server.js",
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@capacitor-community/electron": "^5.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@hookform/resolvers": "^5.7.1",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
